# Supabase — copy these from the Connect modal (top of project page → Framework tab)
#
# URL is your project URL (https://<ref>.supabase.co).
# PUBLISHABLE_KEY (formerly called "anon key") is safe to expose in the browser
#   because it can only do what RLS policies allow (SELECT on the four public
#   tables in our case).
NEXT_PUBLIC_SUPABASE_URL=https://YOURREF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
